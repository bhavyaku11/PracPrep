# ==============================================================================
# PracPrep Backend Environment Configuration Template
# Copy this file to .env and adjust variables as necessary for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application & Environment
PROJECT_NAME="PracPrep API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# Allowed Cross-Origin Resource Sharing (CORS) Origins
# Provide as comma-separated URLs or JSON array string
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# JWT Authentication Configuration
# Generate a strong 32+ character random secret for production (e.g. via `openssl rand -hex 32`)
JWT_SECRET_KEY="insecure-dev-secret-key-change-in-production-min32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Asynchronous PostgreSQL Database Connection URL
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pracprep"

# AI Provider Configuration (Optional for demonstration mode)
# Supported options for DEFAULT_AI_PROVIDER: demonstration, gemini, openai
DEFAULT_AI_PROVIDER="demonstration"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=10.0
GEMINI_MAX_RETRIES=3
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0
OPENAI_API_KEY=""

# Document Upload Constraints
MAX_UPLOAD_SIZE_BYTES=26214400

# Clerk Authentication (Optional / Hybrid Auth)
# Required when verifying Clerk session tokens or syncing Clerk users on backend
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional overrides (automatically inferred from CLERK_PUBLISHABLE_KEY if omitted):
# CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
# CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
