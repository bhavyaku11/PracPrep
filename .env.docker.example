# ==============================================================================
# PracPrep Docker Compose Environment Template
# Copy this file to .env before starting the stack:
#   cp .env.docker.example .env
# DO NOT commit real production credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & Ingress Configuration
# ------------------------------------------------------------------------------
# Host port on which Nginx serves the React application and API reverse proxy.
# Default is 80 (standard HTTP). Change to 3000 or 8080 if port 80 is in use.
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Configuration
# ------------------------------------------------------------------------------
# Credentials and database name used by the 'db' container and backend connection.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_DB=pracprep

# ------------------------------------------------------------------------------
# 3. Backend Runtime & Security Settings
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'staging', or 'production'.
# When set to 'production', the application enforces:
#   - Cryptographically strong JWT_SECRET_KEY (min 32 characters, no placeholders)
#   - HSTS header enforcement on HTTPS requests
#   - Disabling of public /docs and /openapi.json Swagger endpoints
#   - Strict rate-limit client identification ignoring X-Test-Client-Id
ENVIRONMENT=development

# JWT signing secret key.
# For production, generate a strong random secret using:
#   openssl rand -hex 32
JWT_SECRET_KEY=insecure-dev-secret-key-change-in-production-min32chars

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# Rate limiting toggle (slowapi in-memory limiter)
RATE_LIMITING_ENABLED=true

# Centralized logging configuration
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT options: 'auto' (JSON in production, text in dev), 'json', or 'text'
LOG_FORMAT=auto

# ------------------------------------------------------------------------------
# 4. AI Viva Provider Configuration
# ------------------------------------------------------------------------------
# Default provider for question generation and answer evaluation.
# Options: 'demonstration' (deterministic, zero-network-call), 'gemini', 'openai'
# If set to 'gemini' without a valid key, the FallbackAIProvider safely routes
# requests to the deterministic DemonstrationAIProvider.
DEFAULT_AI_PROVIDER=demonstration

# Google Gemini API key (optional for local demonstration mode)
# Required only if DEFAULT_AI_PROVIDER is set to 'gemini' for live AI evaluation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Laboratory Manual Upload Constraints
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (default 25 MB = 26,214,400 bytes)
MAX_UPLOAD_SIZE_BYTES=26214400
