# PracPrep Frontend Environment Configuration
# Base URL for the FastAPI REST Backend (API prefix /api/v1 is appended automatically)
VITE_API_BASE_URL=http://localhost:8000

# Clerk Authentication (Frontend Publishable Key)
# Obtain from Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
